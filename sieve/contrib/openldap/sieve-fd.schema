##
## sieve-fd.schema - Needed by Fusion Directory for managing sieve servers
##

# attributes

attributetype ( 1.3.6.1.4.1.38414.97.1.1 NAME 'fdSieveConnect'
  DESC 'FusionDirectory - PHP connect string for Sieve server'
  EQUALITY caseExactIA5Match
  SYNTAX 1.3.6.1.4.1.1466.115.121.1.26
  SINGLE-VALUE)

attributetype ( 1.3.6.1.4.1.38414.97.1.2 NAME 'fdSieveAdmin'
  DESC 'FusionDirectory - Sieve admin account'
  EQUALITY caseExactIA5Match
  SYNTAX 1.3.6.1.4.1.1466.115.121.1.26
  SINGLE-VALUE)

attributetype ( 1.3.6.1.4.1.38414.97.1.3 NAME 'fdSievePassword'
  DESC 'FusionDirectory - Sieve admin password'
  EQUALITY caseExactIA5Match
  SYNTAX 1.3.6.1.4.1.1466.115.121.1.26
  SINGLE-VALUE)

# Objectclasses
objectclass (1.3.6.1.4.1.38414.97.2.1 NAME 'fdSieveServer' SUP top AUXILIARY
  DESC 'FusionDirectory - Sieve server description'
  MUST ( cn $ fdSieveConnect $ fdSieveAdmin $ fdSievePassword )
  MAY  ( ))
