#: personal/kerberos/class_kerberosAccount.inc:263
msgid "Prohibit issuance of service tickets"
msgstr ""

#: personal/kerberos/class_kerberosAccount.inc:263
msgid "Prohibit the KDC to issue service tickets for this principal."
msgstr ""

#: personal/kerberos/class_kerberosAccount.inc:268
msgid "Password change service"
msgstr ""

#: personal/kerberos/class_kerberosAccount.inc:268
msgid ""
"If this flag is enabled, it marks this principal as a password change "
"service. This should only be used in special cases, for example, if a user "
"password has expired, then the user has to get tickets for that principal "
"without going through the normal password authentication in order to be able "
"to change the password."
msgstr ""

