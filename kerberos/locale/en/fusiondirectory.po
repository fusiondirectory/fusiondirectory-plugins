#: personal/kerberos/class_kerberosAccount.inc:203
msgid "Prohibit postdated tickets"
msgstr ""

#: personal/kerberos/class_kerberosAccount.inc:203
msgid "Prohibit the principal to obtain postdateable tickets."
msgstr ""

#: personal/kerberos/class_kerberosAccount.inc:208
msgid "Prohibit forwardable tickets"
msgstr ""

#: personal/kerberos/class_kerberosAccount.inc:208
msgid ""
"Prohibit the principal to obtain a session key for another user, permitting "
"user-to-user authentication for this principal."
msgstr ""

#: personal/kerberos/class_kerberosAccount.inc:213
msgid "Disallow Ticket-Granting Service"
msgstr ""

#: personal/kerberos/class_kerberosAccount.inc:213
msgid ""
"Disallow a principal to obtain tickets based on a ticket-granting-ticket, "
"rather than repeating the authentication process that was used to obtain the "
"TGT."
msgstr ""

#: personal/kerberos/class_kerberosAccount.inc:218
msgid "Prohibit renewable tickets"
msgstr ""

#: personal/kerberos/class_kerberosAccount.inc:218
msgid "Prohibit the principal to obtain renewable tickets."
msgstr ""

#: personal/kerberos/class_kerberosAccount.inc:223
msgid "Disallow proxiable tickets"
msgstr ""

#: personal/kerberos/class_kerberosAccount.inc:223
msgid "Prohibit the principal to obtain proxy tickets."
msgstr ""

#: personal/kerberos/class_kerberosAccount.inc:228
msgid "Disallow user to user authentification"
msgstr ""

#: personal/kerberos/class_kerberosAccount.inc:228
msgid ""
"Enabling this flag disallows the principal to obtain a session key for "
"another user, permitting user-to-user authentication for this principal."
msgstr ""

#: personal/kerberos/class_kerberosAccount.inc:233
msgid "Forbid ticket issuance"
msgstr ""

#: personal/kerberos/class_kerberosAccount.inc:233
msgid ""
"Enabling this flag essentially deactivates the principal within this realm."
msgstr ""

#: personal/kerberos/class_kerberosAccount.inc:238
msgid "Preauthentication required"
msgstr ""

#: personal/kerberos/class_kerberosAccount.inc:238
msgid ""
"If this flag is enabled on a client principal, then that principal is "
"required to preauthenticate to the KDC before receiving any tickets. On a "
"service principal, enabling this flag means that service tickets for this "
"principal will only be issued to clients with a TGT that has the "
"preauthenticated bit set."
msgstr ""

#: personal/kerberos/class_kerberosAccount.inc:243
msgid "Hardware preauthentication"
msgstr ""

#: personal/kerberos/class_kerberosAccount.inc:243
msgid ""
"If this flag is enabled, then the principal is required to preauthenticate "
"using a hardware device before receiving any tickets."
msgstr ""

#: personal/kerberos/class_kerberosAccount.inc:248
msgid "Force a password change"
msgstr ""

#: personal/kerberos/class_kerberosAccount.inc:248
msgid "Enabling this flag forces a password change for this principal."
msgstr ""

