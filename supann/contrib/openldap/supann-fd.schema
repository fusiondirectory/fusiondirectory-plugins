##
## supann-fd.schema - Needed by Fusion Directory for managing SupAnn resource
##

attributetype ( 1.3.6.1.4.1.38414.28.1.1 NAME 'fdSupannResourceName'
  DESC 'FusionDirectory - Name of the custom supannRessourceEtatDate'
  EQUALITY caseIgnoreMatch
  SUBSTR caseIgnoreSubstringsMatch
  SYNTAX 1.3.6.1.4.1.1466.115.121.1.15)

attributetype ( 1.3.6.1.4.1.38414.28.1.2 NAME 'fdSupannRessourceLabel'
  DESC 'FusionDirectory - label of the custom supannRessourceEtatDate'
  EQUALITY caseIgnoreMatch
  SUBSTR caseIgnoreSubstringsMatch
  SYNTAX 1.3.6.1.4.1.1466.115.121.1.15)

attributetype ( 1.3.6.1.4.1.38414.28.1.3 NAME 'fdSupannSubStateName'
  DESC 'FusionDirectory - Name of the supann resource substate'
  EQUALITY caseIgnoreMatch
  SUBSTR caseIgnoreSubstringsMatch
  SYNTAX 1.3.6.1.4.1.1466.115.121.1.15)

attributetype ( 1.3.6.1.4.1.38414.28.1.4 NAME 'fdSupannSubStateLabel'
  DESC 'FusionDirectory - Label of the supann resource substate'
  EQUALITY caseIgnoreMatch
  SUBSTR caseIgnoreSubstringsMatch
  SYNTAX 1.3.6.1.4.1.1466.115.121.1.15)

attributetype ( 1.3.6.1.4.1.38414.28.1.5 NAME 'fdSupannRessourceState'
  DESC 'FusionDirectory - State of the ressource by default A,S,I'
  EQUALITY caseIgnoreMatch
  SUBSTR caseIgnoreSubstringsMatch
  SYNTAX 1.3.6.1.4.1.1466.115.121.1.15)

objectclass ( 1.3.6.1.4.1.38414.28.10.2 NAME 'fdSupannObjects'
  DESC 'FusionDirectory SupAnn Resource'
  SUP top AUXILIARY
  MUST ( fdSupannResourceName $ fdSupannRessourceLabel )
  MAY ( description $ fdSupannSubStateName $ fdSupannSubStateLabel $ fdSupannRessourceState ) )

