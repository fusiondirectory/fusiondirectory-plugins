  EQUALITY caseIgnoreMatch
  SUBSTR caseIgnoreSubstringsMatch
  SYNTAX 1.3.6.1.4.1.1466.115.121.1.15)

attributetype ( 1.3.6.1.4.1.38414.28.1.9 NAME 'fdSupannConsentObjectName'
  DESC 'FusionDirectory - Name of the supann consent object'
  EQUALITY caseIgnoreMatch
  SUBSTR caseIgnoreSubstringsMatch
  SYNTAX 1.3.6.1.4.1.1466.115.121.1.15)

# TODO deprecated after 1.6 and remove the may in the objectclass
attributetype ( 1.3.6.1.4.1.38414.28.1.10 NAME 'fdSupannConsentObjectLabel'
  DESC 'FusionDirectory - Label of the supann consent object'
  EQUALITY caseIgnoreMatch
  SUBSTR caseIgnoreSubstringsMatch
  SYNTAX 1.3.6.1.4.1.1466.115.121.1.15)

attributetype ( 1.3.6.1.4.1.38414.28.1.11 NAME 'fdSupannConsentTypeName'
  DESC 'FusionDirectory - Name of the supann consent type'
  EQUALITY caseIgnoreMatch
  SUBSTR caseIgnoreSubstringsMatch
  SYNTAX 1.3.6.1.4.1.1466.115.121.1.15)

