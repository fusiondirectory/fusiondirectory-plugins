##
## supann-fd.schema - Needed by Fusion Directory for managing SupAnn resource
##

attributetype ( 1.3.6.1.4.1.38414.28.1.1 NAME 'fdSupannRessourceName'
  DESC 'FusionDirectory - Name of the custom supannRessourceEtatDate'
  EQUALITY caseIgnoreMatch
  SUBSTR caseIgnoreSubstringsMatch
  SYNTAX 1.3.6.1.4.1.1466.115.121.1.15)

attributetype ( 1.3.6.1.4.1.38414.28.1.2 NAME 'fdSupannRessourceLabel'
  DESC 'FusionDirectory - label of the custom supannRessourceEtatDate'
  EQUALITY caseIgnoreMatch
  SUBSTR caseIgnoreSubstringsMatch
  SYNTAX 1.3.6.1.4.1.1466.115.121.1.15)

attributetype ( 1.3.6.1.4.1.38414.28.1.3 NAME 'fdSupannStateName'
  DESC 'FusionDirectory - Name of the supann ressource state'
  EQUALITY caseIgnoreMatch
  SUBSTR caseIgnoreSubstringsMatch
  SYNTAX 1.3.6.1.4.1.1466.115.121.1.15)

attributetype ( 1.3.6.1.4.1.38414.28.1.4 NAME 'fdSupannStateState'
  DESC 'FusionDirectory - State of the ressource by default A,S,I'
  EQUALITY caseIgnoreMatch
  SUBSTR caseIgnoreSubstringsMatch
  SYNTAX 1.3.6.1.4.1.1466.115.121.1.15)

attributetype ( 1.3.6.1.4.1.38414.28.1.5 NAME 'fdSupannSubStateName'
  DESC 'FusionDirectory - Name of the supann resource substate'
  EQUALITY caseIgnoreMatch
  SUBSTR caseIgnoreSubstringsMatch
  SYNTAX 1.3.6.1.4.1.1466.115.121.1.15)

attributetype ( 1.3.6.1.4.1.38414.28.1.6 NAME 'fdSupannSubStateList'
  DESC 'FusionDirectory - dn of all the supann resource substate linked to a state'
  EQUALITY caseIgnoreMatch
  SUBSTR caseIgnoreSubstringsMatch
  SYNTAX 1.3.6.1.4.1.1466.115.121.1.15)

attributetype ( 1.3.6.1.4.1.38414.28.1.7 NAME 'fdSupannCiviliteName'
  DESC 'FusionDirectory - Name of the supannCivilite object'
  EQUALITY caseIgnoreMatch
  SUBSTR caseIgnoreSubstringsMatch
  SYNTAX 1.3.6.1.4.1.1466.115.121.1.15)

attributetype ( 1.3.6.1.4.1.38414.28.1.8 NAME 'fdSupannCiviliteLabel'
  DESC 'FusionDirectory - label of the supannCivlite object'
  EQUALITY caseIgnoreMatch
  SUBSTR caseIgnoreSubstringsMatch
  SYNTAX 1.3.6.1.4.1.1466.115.121.1.15)

objectclass ( 1.3.6.1.4.1.38414.28.10.2 NAME 'fdSupannRessource'
  DESC 'FusionDirectory SupAnnRessource'
  MUST ( fdSupannRessourceName $ fdSupannRessourceLabel )
  MAY ( description ))

objectclass ( 1.3.6.1.4.1.38414.28.11.2 NAME 'fdSupannRessourceState'
  DESC 'FusionDirectory SupAnnRessource State'
  MUST ( fdSupannStateName $ fdSupannRessourceLabel )
  MAY ( description $ fdSupannSubStateList ))

objectclass ( 1.3.6.1.4.1.38414.28.12.2 NAME 'fdSupannRessourceSubState'
  DESC 'FusionDirectory SupAnnRessourceSubState'
  MUST ( fdSupannSubStateName $ fdSupannRessourceLabel )
  MAY ( description ))

objectclass ( 1.3.6.1.4.1.38414.28.10.4 NAME 'fdSupannCivilite'
  DESC 'FusionDirectory SupAnnRessource'
  MUST ( fdSupannCiviliteName $ fdSupannCiviliteLabel )
  MAY ( description ))

objectclass ( 1.3.6.1.4.1.38414.88.2.1 NAME 'fdFranceConnect' SUP top AUXILIARY
  DESC 'FusionDirectory - Supann FranceConnect tab attributes'
  MAY ( supannNomDeNaissance $  supannPrenomsEtatCivil $ supannOIDCDateDeNaissance $ supannOIDCGenre $
        supannCodeINSEEPaysDeNaissance $ supannFCSub $ supannCodeINSEEVilleDeNaissance ))

objectclass ( 1.3.6.1.4.1.38414.88.3.1 NAME 'fdSupannStudent' SUP top AUXILIARY
  DESC 'FusionDirectory - Supann Student tab attributes'
  MAY ( supannCodeINE $ supannEtuInscription $ supannEtuAnneeInscription $ supannEtuRegimeInscription $
        supannEtuSecteurDisciplinaire $ supannEtuTypeDiplome $ supannEtuCursusAnnee $ supannEtuDiplome $ supannEtuElementPedagogique ))

objectclass ( 1.3.6.1.4.1.38414.88.4.1 NAME 'fdSupannEmployee' SUP top AUXILIARY
  DESC 'FusionDirectory - Supann Employee attributes'
  MAY ( supannEmpId $ supannEmpCorps $ supannActivite $ supannRoleGenerique $ supannRoleEntite ))
