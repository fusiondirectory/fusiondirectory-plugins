##
## dns-fd.schema - Needed by Fusion Directory for managing DNS
##

# Attributes
attributetype ( 1.3.6.1.4.1.38414.51.10.1 NAME 'fdDNSZoneDn'
  DESC 'FusionDirectory - dn of zones'
  EQUALITY caseIgnoreMatch
  SUBSTR caseIgnoreSubstringsMatch
  SYNTAX 1.3.6.1.4.1.1466.115.121.1.15)

attributetype ( 1.3.6.1.4.1.38414.51.11.1 NAME 'fdDNSViewMatchClientsAcl'
  DESC 'FusionDirectory - DNS view ACL name for match-clients option'
  EQUALITY caseIgnoreMatch
  SUBSTR caseIgnoreSubstringsMatch
  SYNTAX 1.3.6.1.4.1.1466.115.121.1.15 SINGLE-VALUE)

attributetype ( 1.3.6.1.4.1.38414.51.11.2 NAME 'fdDNSViewMatchDestinationsAcl'
  DESC 'FusionDirectory - DNS view ACL name for match-destinations option'
  EQUALITY caseIgnoreMatch
  SUBSTR caseIgnoreSubstringsMatch
  SYNTAX 1.3.6.1.4.1.1466.115.121.1.15 SINGLE-VALUE)

attributetype ( 1.3.6.1.4.1.38414.51.11.3 NAME 'fdDNSViewMatchRecursiveOnly'
  DESC 'FusionDirectory - DNS view match-recursive-only option'
  EQUALITY booleanMatch
  SYNTAX 1.3.6.1.4.1.1466.115.121.1.7
  SINGLE-VALUE )

attributetype ( 1.3.6.1.4.1.38414.51.12.1 NAME 'fdDNSAclMatchList'
  DESC 'FusionDirectory - DNS acl address_match_list'
  EQUALITY caseIgnoreMatch
  SUBSTR caseIgnoreSubstringsMatch
  SYNTAX 1.3.6.1.4.1.1466.115.121.1.15)

##
## argonaut.schema - Needed by Fusion Directory for managing an Argonaut Server
##

attributetype ( 1.3.6.1.4.1.38414.51.13.1 NAME 'fdDNSZoneBindDir'
  DESC 'Fusion Directory - DNS bind directory.'
  EQUALITY caseExactIA5Match
  SYNTAX 1.3.6.1.4.1.1466.115.121.1.26
  SINGLE-VALUE )

attributetype ( 1.3.6.1.4.1.38414.51.13.2 NAME 'fdDNSZoneAllowNotify'
  DESC 'Fusion Directory - DNS allow notify.'
  OBSOLETE
  EQUALITY booleanMatch
  SYNTAX 1.3.6.1.4.1.1466.115.121.1.7
  SINGLE-VALUE )

attributetype ( 1.3.6.1.4.1.38414.51.13.3 NAME 'fdDNSZoneAllowUpdate'
  DESC 'Fusion Directory - DNS allow update.'
  EQUALITY caseExactIA5Match
  SYNTAX 1.3.6.1.4.1.1466.115.121.1.26
  SINGLE-VALUE )

attributetype ( 1.3.6.1.4.1.38414.51.13.4 NAME 'fdDNSZoneAllowTransfer'
  DESC 'Fusion Directory - DNS allow transfer.'
  EQUALITY caseExactIA5Match
  SYNTAX 1.3.6.1.4.1.1466.115.121.1.26
  SINGLE-VALUE )

attributetype ( 1.3.6.1.4.1.38414.51.13.5 NAME 'fdDNSZoneTTL'
  DESC 'Fusion Directory - DNS zone ttl.'
  EQUALITY caseExactIA5Match
  SYNTAX 1.3.6.1.4.1.1466.115.121.1.26
  SINGLE-VALUE )

attributetype ( 1.3.6.1.4.1.38414.51.13.6 NAME 'fdDNSZoneRndc'
  DESC 'Fusion Directory - DNS rndc path (usually /usr/sbin/rndc).'
  EQUALITY caseExactIA5Match
  SYNTAX 1.3.6.1.4.1.1466.115.121.1.26
  SINGLE-VALUE )

attributetype ( 1.3.6.1.4.1.38414.51.13.7 NAME 'fdDNSZoneBindCacheDir'
  DESC 'Fusion Directory - DNS bind cache directory.'
  EQUALITY caseExactIA5Match
  SYNTAX 1.3.6.1.4.1.1466.115.121.1.26
  SINGLE-VALUE )

attributetype ( 1.3.6.1.4.1.38414.51.13.8 NAME 'fdDNSZoneNoReverse'
  DESC 'Fusion Directory - DNS do not write the reverse zone.'
  EQUALITY booleanMatch
  SYNTAX 1.3.6.1.4.1.1466.115.121.1.7
  SINGLE-VALUE )

attributetype ( 1.3.6.1.4.1.38414.51.13.9 NAME 'fdDNSZoneCheckNames'
  DESC 'Fusion Directory - DNS check-names directive ( fail | warn | ignore ).'
  EQUALITY caseExactIA5Match
  SYNTAX 1.3.6.1.4.1.1466.115.121.1.26
  SINGLE-VALUE )

attributetype ( 1.3.6.1.4.1.38414.51.13.10 NAME 'fdDNSZoneSearchBase'
  DESC 'FusionDirectory - DNS dn of LDAP base to use for search'
  EQUALITY caseIgnoreMatch
  SUBSTR caseIgnoreSubstringsMatch
  SYNTAX 1.3.6.1.4.1.1466.115.121.1.15
  SINGLE-VALUE )

attributetype ( 1.3.6.1.4.1.38414.51.13.11 NAME 'fdDNSZoneSlaveZones'
  DESC 'FusionDirectory - DNS Zones names and associated masters'
  EQUALITY caseIgnoreMatch
  SUBSTR caseIgnoreSubstringsMatch
  SYNTAX 1.3.6.1.4.1.1466.115.121.1.15)

attributetype ( 1.3.6.1.4.1.38414.51.13.12 NAME 'fdDNSZoneNotify'
  DESC 'FusionDirectory - DNS notify - should be yes, no or explicit.'
  EQUALITY caseExactIA5Match
  SYNTAX 1.3.6.1.4.1.1466.115.121.1.26
  SINGLE-VALUE )

# Object Class
objectclass ( 1.3.6.1.4.1.38414.51.2.1 NAME 'fdDNSHost'
  DESC 'FusionDirectory - DNS host'
  SUP top AUXILIARY
  MUST (  )
  MAY ( fdDNSZoneDn ) )

objectclass ( 1.3.6.1.4.1.38414.51.2.2 NAME 'fdDNSView'
  DESC 'FusionDirectory - DNS view for split horizon'
  MUST ( cn )
  MAY ( fdDNSZoneDn $ fdDNSViewMatchClientsAcl $
  fdDNSViewMatchDestinationsAcl $ fdDNSViewMatchRecursiveOnly ) )

objectclass ( 1.3.6.1.4.1.38414.51.2.3 NAME 'fdDNSAcl'
  DESC 'FusionDirectory - DNS acl'
  MUST ( cn )
  MAY ( fdDNSAclMatchList ) )

# Object Class from argonaut

objectclass ( 1.3.6.1.4.1.38414.51.2.4 NAME 'fdDNSConfig'
  DESC 'DNS configuration'
  SUP top AUXILIARY
  MUST ( fdDNSZoneBindDir $ fdDNSZoneBindCacheDir $ fdDNSZoneTTL $ fdDNSZoneRndc )
  MAY ( fdDNSZoneAllowUpdate $ fdDNSZoneAllowTransfer $
    fdDNSZoneNoReverse $ fdDNSZoneCheckNames $ fdDNSZoneSearchBase $
    fdDNSZoneSlaveZones $ fdDNSZoneNotify $ fdDNSZoneAllowNotify ) )
