##
## extractor-fd.schema - Needed by Fusion Directory for extractor plugin
##
## Allows extracting LDAP data based on selected members or groups and a chosen format.
##

# Attributes

attributetype ( 1.3.6.1.4.1.38414.93.1.1 NAME 'fdExtractorTaskMembers'
    DESC 'Fusion Directory - List of members or groups for extraction tasks'
    EQUALITY caseExactMatch
    SYNTAX 1.3.6.1.4.1.1466.115.121.1.15 )

attributetype ( 1.3.6.1.4.1.38414.93.1.2 NAME 'fdExtractorTaskListOfDN'
    DESC 'Fusion Directory - DNs derived from the selected members/groups'
    EQUALITY caseExactMatch
    SYNTAX 1.3.6.1.4.1.1466.115.121.1.15 )

attributetype ( 1.3.6.1.4.1.38414.93.1.3 NAME 'fdExtractorTaskFormat'
    DESC 'Fusion Directory - Format used for data extraction (CSV for now, extensible later)'
    EQUALITY caseExactMatch
    SYNTAX 1.3.6.1.4.1.1466.115.121.1.15
    SINGLE-VALUE )

# Email notification attributes

attributetype ( 1.3.6.1.4.1.38414.93.1.4 NAME 'fdExtractorRecipientsMembers'
    DESC 'Fusion Directory - Members or groups to receive the extract by email'
    EQUALITY caseExactMatch
    SYNTAX 1.3.6.1.4.1.1466.115.121.1.15 )

attributetype ( 1.3.6.1.4.1.38414.93.1.5 NAME 'fdExtractorEmailSender'
    DESC 'Fusion Directory - Email address from which the extract will be sent'
    EQUALITY caseExactMatch
    SYNTAX 1.3.6.1.4.1.1466.115.121.1.15 )

# New attribute for extractable attributes selection

attributetype ( 1.3.6.1.4.1.38414.93.1.6 NAME 'fdExtractorTaskAttributes'
    DESC 'Fusion Directory - List of LDAP attributes to extract (empty or ALL for all)'
    EQUALITY caseExactMatch
    SYNTAX 1.3.6.1.4.1.1466.115.121.1.15 )

# Object Class

objectclass ( 1.3.6.1.4.1.38414.93.2.1 NAME 'fdExtractorTasks'
    DESC 'Fusion Directory - Extractor tasks plugin object class'
    SUP top
    AUXILIARY
    MUST ( fdExtractorTaskMembers $ fdExtractorTaskFormat $ fdExtractorRecipientsMembers $ fdExtractorEmailSender )
    MAY ( fdExtractorTaskListOfDN $ fdExtractorTaskAttributes ) )
