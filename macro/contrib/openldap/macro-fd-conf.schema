attributetype ( 1.3.6.1.4.1.38414.99.1.1 NAME 'fdMacroAttributesList'
  DESC 'FusionDirectory - Ask attributes list'
  EQUALITY caseExactMatch
  SYNTAX 1.3.6.1.4.1.1466.115.121.1.15 )

objectclass ( 1.3.6.1.4.1.38414.99.2.1 NAME 'fdMacroPluginConf'
  DESC 'FusionDirectory - Macro plugin configuration'
  SUP top AUXILIARY
  MUST ( cn )
  MAY ( fdMacroAttributesList ) )
  
